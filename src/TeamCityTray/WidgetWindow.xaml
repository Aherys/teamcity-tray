<Window x:Class="TeamCityTray.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TeamCityTray"
        Title="TeamCity Tray" Width="390" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="11">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="#B7C0D0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" Background="#EB1E2128" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="6,0,6,4" MouseLeftButtonDown="OnMouseDown">
        <StackPanel>
            <Grid x:Name="Grip" Height="14" Margin="0,0,0,2" Background="Transparent" Cursor="SizeAll"
                  ToolTip="Drag to move">
                <TextBlock Text="&#x22EE;&#x22EE;" Foreground="#6E7788" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="TeamCity" Foreground="#6E7788" FontSize="9" VerticalAlignment="Center" />
                <TextBlock Text="offline" Foreground="#F85149" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding IsOffline, Converter={StaticResource B2V}}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RowViewModel}">
                        <Grid Height="20" Background="Transparent" Margin="{Binding Indent}" ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}"
                                     Visibility="{Binding ShowDot, Converter={StaticResource B2V}}" />
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding DotBrush}" FontFamily="Segoe UI Symbol"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#DDE3EE"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,6,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Number}" Foreground="#8A94A6"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ProgressBar Grid.Column="3" Height="4" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{Binding BarBrush}" Background="#33FFFFFF" BorderThickness="0"
                                         Visibility="{Binding ShowBar, Converter={StaticResource B2V}}" />
                            <TextBlock Grid.Column="4" Text="{Binding PercentText}" Foreground="#C5CCD8"
                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{Binding ElapsedText}" Foreground="#8A94A6"
                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="6" Style="{StaticResource IconBtn}" Content="&#x2715;" ToolTip="Dismiss"
                                    Foreground="#F85149" Click="OnDismissClick"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource B2V}}" />
                            <StackPanel Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,0,18,0" Background="#F01E2128">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource IconBtn}" Content="&#x27F3;" ToolTip="Re-run" Click="OnRerunClick"
                                        Visibility="{Binding CanRerun, Converter={StaticResource B2V}}" />
                                <Button Style="{StaticResource IconBtn}" Content="&#x2197;" ToolTip="Open in TeamCity" Click="OnOpenClick" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="idle" Foreground="#6E7788" FontSize="10" Margin="0,2,0,0"
                       Visibility="{Binding IsIdle, Converter={StaticResource B2V}}" />
        </StackPanel>
    </Border>
</Window>
